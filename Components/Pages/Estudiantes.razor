@page "/estudiantes"
@using LP3.BlazorServer.Domain.Enums
@using LP3.BlazorServer.Shared.DTOs
@using LP3.BlazorServer.Application.Services
@inject IEstudianteService EstudianteService

<h3>Estudiantes</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Lista de estudiantes</h5>
                @if (isLoading)
                {
                    <p>Cargando...</p>
                }
                else if (!estudiantes.Any())
                {
                    <p>No hay estudiantes registrados.</p>
                }
                else
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Documento</th>
                                <th>Matricula</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var estudiante in estudiantes)
                            {
                                <tr>
                                    <td>@estudiante.Id</td>
                                    <td>@estudiante.Nombre @estudiante.Apellido</td>
                                    <td>@estudiante.NumeroDocumento</td>
                                    <td>@estudiante.Matricula</td>
                                    <td>@estudiante.Estado</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary me-2" @onclick="() => Edit(estudiante)">Editar</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(estudiante.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@((current.Id == 0) ? "Agregar estudiante" : "Editar estudiante")</h5>

                <EditForm Model="current" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="current.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="current.Apellido" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText type="email" class="form-control" @bind-Value="current.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="current.Telefono" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Número documento</label>
                        <InputText class="form-control" @bind-Value="current.NumeroDocumento" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Matrícula</label>
                        <InputText class="form-control" @bind-Value="current.Matricula" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha de nacimiento</label>
                        <InputDate class="form-control" @bind-Value="current.FechaNacimiento" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <InputSelect class="form-select" @bind-Value="current.Estado">
                            @foreach (var estado in Enum.GetValues<EstadoEstudiante>())
                            {
                                <option value="@estado">@estado</option>
                            }
                        </InputSelect>
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Guardar</button>
                    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Limpiar</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<EstudianteDto> estudiantes = new();
    private EstudianteDto current = new() { FechaNacimiento = DateTime.Today, FechaRegistro = DateTime.Now };
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadEstudiantesAsync();
    }

    private async Task LoadEstudiantesAsync()
    {
        isLoading = true;
        estudiantes = (await EstudianteService.GetAll()).ToList();
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (current.Id == 0)
        {
            await EstudianteService.CreateAsync(current);
        }
        else
        {
            await EstudianteService.UpdateAsync(current.Id, current);
        }

        await LoadEstudiantesAsync();
        ClearForm();
    }

    private void Edit(EstudianteDto estudiante)
    {
        current = new EstudianteDto
        {
            Id = estudiante.Id,
            Nombre = estudiante.Nombre,
            Apellido = estudiante.Apellido,
            Email = estudiante.Email,
            Telefono = estudiante.Telefono,
            NumeroDocumento = estudiante.NumeroDocumento,
            FechaNacimiento = estudiante.FechaNacimiento,
            FechaRegistro = estudiante.FechaRegistro,
            Matricula = estudiante.Matricula,
            Estado = estudiante.Estado
        };
    }

    private async Task DeleteAsync(int id)
    {
        await EstudianteService.DeleteAsync(id);
        await LoadEstudiantesAsync();
    }

    private void ClearForm()
    {
        current = new EstudianteDto { FechaNacimiento = DateTime.Today, FechaRegistro = DateTime.Now };
    }
}
